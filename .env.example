# Copy this file to `.env` in the project root and fill in your keys.
# `.env` is gitignored — never commit real secrets (public GitHub).
#
# OpenRouter (optional AI advisor / prompt plans):
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# YouTube upload (optional). Create a Desktop OAuth client:
# https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3, then paste the client id + secret here
# OR download the JSON as data/youtube/client_secret.json
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
